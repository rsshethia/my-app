# Copy to .env (never commit .env)
# Public map token (Vite inlines VITE_* into the bundle — safe for Mapbox only)
VITE_MAPBOX_TOKEN=
# Local-dev fallback only. Production uses server-side VLINE_KEY via /api/live.
VITE_VLINE_KEY=

# Server (used by server/index.js + collector — never prefix with VITE_)
VLINE_KEY=
# Pooled Neon URL, e.g. postgresql://user:pass@ep-xyz-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# ...or split parameters instead of DATABASE_URL (Neon dashboard "Parameters" style):
# PGHOST=ep-xyz-pooler.<region>.aws.neon.tech
# PGDATABASE=neondb
# PGUSER=
# PGPASSWORD=
# Collector interval in ms (60000 = 1/min, kind to Render free hours)
POLL_MS=60000
